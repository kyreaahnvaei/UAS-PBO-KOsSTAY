  <property name="styleSheet">
   <string notr="true">
* { font-family: 'Segoe UI', 'Inter', sans-serif; font-size: 10pt; color: #243040; }
QMainWindow, QWidget#centralwidget { background: #F4F8F7; }
QLabel { background: transparent; }
QCheckBox { background: transparent; spacing: 8px; }
QScrollArea { background: transparent; border: none; }

QFrame#loginShell { background: #FFFFFF; border-radius: 28px; }
QFrame#brandPanel { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #E9F8F2, stop:1 #CDEFF2); border-top-left-radius: 28px; border-bottom-left-radius: 28px; }
QWidget#centralwidgetLogin { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #1B2735, stop:0.55 #0B5D73, stop:1 #12A87B); }

QFrame#sidebarUser, QFrame#sidebarAdmin { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #1B2735, stop:1 #0B5D73); }
QFrame#sidebarUser QLabel, QFrame#sidebarAdmin QLabel { color: #FFFFFF; }
QFrame#logoCard { background: #FFFFFF; border-radius: 18px; }
QLabel[role=&quot;roleBadge&quot;] { background: #F7A823; color: #1B2735; border-radius: 10px; padding: 4px 12px; font-weight: 800; letter-spacing: 2px; }
QFrame#sidebarUser QLabel[role=&quot;roleBadge&quot;], QFrame#sidebarAdmin QLabel[role=&quot;roleBadge&quot;] { color: #1B2735; }
QLabel[role=&quot;menuHint&quot;] { color: #9FC3CB; font-size: 9pt; }
QPushButton[nav=&quot;true&quot;] { color: #CFE3E6; text-align: left; padding: 13px 18px; border: none; border-radius: 12px; font-weight: 600; background: transparent; }
QPushButton[nav=&quot;true&quot;]:hover { background: rgba(255,255,255,0.10); color: #FFFFFF; }
QPushButton[nav=&quot;true&quot;]:checked { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #12A87B, stop:1 #2DBE7E); color: #FFFFFF; }
QPushButton[nav=&quot;logout&quot;] { color: #FFD9A0; text-align: left; padding: 12px 18px; border: 1px solid rgba(247,168,35,0.7); border-radius: 12px; font-weight: 700; background: transparent; }
QPushButton[nav=&quot;logout&quot;]:hover { background: #F7A823; color: #1B2735; }

QFrame[card=&quot;white&quot;] { background: #FFFFFF; border: 1px solid #E1ECE9; border-radius: 18px; }
QFrame[card=&quot;mint&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #E3F7EF, stop:1 #D2EEF3); border: none; border-radius: 18px; }
QFrame[card=&quot;green&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #12A87B, stop:1 #2DBE7E); border-radius: 18px; }
QFrame[card=&quot;navy&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #1B2735, stop:1 #0B5D73); border-radius: 18px; }
QFrame[card=&quot;orange&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #F7A823, stop:1 #FFC857); border-radius: 18px; }
QFrame[card=&quot;teal&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #0B5D73, stop:1 #12A87B); border-radius: 18px; }
QFrame[card=&quot;green&quot;] QLabel, QFrame[card=&quot;navy&quot;] QLabel, QFrame[card=&quot;teal&quot;] QLabel { color: #FFFFFF; }
QFrame[card=&quot;orange&quot;] QLabel { color: #1B2735; }

QLabel[role=&quot;title&quot;] { font-size: 22pt; font-weight: 800; color: #1B2735; }
QLabel[role=&quot;subtitle&quot;] { font-size: 10.5pt; color: #6B7B8C; }
QLabel[role=&quot;section&quot;] { font-size: 13pt; font-weight: 700; color: #1B2735; }
QLabel[role=&quot;statlabel&quot;] { font-size: 10pt; font-weight: 600; }
QLabel[role=&quot;statvalue&quot;] { font-size: 22pt; font-weight: 800; }
QLabel[role=&quot;statsub&quot;] { font-size: 9pt; }
QLabel[role=&quot;price&quot;] { font-size: 14pt; font-weight: 800; color: #12A87B; }
QLabel[role=&quot;roomname&quot;] { font-size: 12pt; font-weight: 700; color: #1B2735; }
QLabel[role=&quot;muted&quot;] { color: #6B7B8C; }
QLabel[role=&quot;error&quot;] { background: #FDECEC; color: #D64545; border-radius: 10px; padding: 8px 12px; font-weight: 600; }
QLabel[role=&quot;fieldlabel&quot;] { font-weight: 600; color: #1B2735; }
QLabel[role=&quot;emoji&quot;] { font-size: 40pt; }
QLabel[role=&quot;chip_mint&quot;] { background: #DFF5EC; color: #0B6B55; border-radius: 12px; padding: 6px 12px; font-weight: 600; }
QLabel[role=&quot;chip_green&quot;] { background: #12A87B; color: #FFFFFF; border-radius: 12px; padding: 5px 12px; font-weight: 700; }
QLabel[role=&quot;chip_orange&quot;] { background: #FFF0D2; color: #A8680A; border-radius: 12px; padding: 5px 12px; font-weight: 700; }
QLabel[role=&quot;chip_navy&quot;] { background: #E4EAF0; color: #1B2735; border-radius: 12px; padding: 5px 12px; font-weight: 700; }
QFrame[card=&quot;roomimg&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #D9F3EA, stop:1 #BFE6EE); border-radius: 14px; border: none; }
QFrame[card=&quot;roomimg&quot;] QLabel { color: #0B5D73; }

QPushButton[variant=&quot;primary&quot;] { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #0B5D73, stop:1 #12A87B); color: #FFFFFF; border: none; border-radius: 12px; padding: 11px 22px; font-weight: 700; }
QPushButton[variant=&quot;primary&quot;]:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #0E7390, stop:1 #1FC490); }
QPushButton[variant=&quot;accent&quot;] { background: #F7A823; color: #1B2735; border: none; border-radius: 12px; padding: 11px 22px; font-weight: 700; }
QPushButton[variant=&quot;accent&quot;]:hover { background: #FFB93F; }
QPushButton[variant=&quot;danger&quot;] { background: #FDECEC; color: #D64545; border: 1px solid #F5BCBC; border-radius: 12px; padding: 11px 22px; font-weight: 700; }
QPushButton[variant=&quot;danger&quot;]:hover { background: #D64545; color: #FFFFFF; }
QPushButton[variant=&quot;ghost&quot;] { background: transparent; color: #0B5D73; border: 1.5px solid #0B5D73; border-radius: 12px; padding: 10px 22px; font-weight: 700; }
QPushButton[variant=&quot;ghost&quot;]:hover { background: #0B5D73; color: #FFFFFF; }
QPushButton[variant=&quot;link&quot;] { background: transparent; color: #12A87B; border: none; font-weight: 700; }
QPushButton[variant=&quot;link&quot;]:hover { color: #0B5D73; text-decoration: underline; }

QLineEdit, QComboBox, QSpinBox, QDateEdit, QTextEdit { background: #FFFFFF; border: 1.5px solid #D5E3E0; border-radius: 12px; padding: 10px 14px; selection-background-color: #12A87B; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus { border: 1.5px solid #12A87B; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 28px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 1.5px solid #12A87B; background: #FFFFFF; }
QCheckBox::indicator:checked { background: #12A87B; }

QTableWidget { background: #FFFFFF; border: 1px solid #E1ECE9; border-radius: 14px; gridline-color: transparent; alternate-background-color: #F4FAF8; selection-background-color: #D9F3EA; selection-color: #1B2735; }
QTableWidget::item { padding: 10px; border: none; }
QHeaderView::section { background: #1B2735; color: #FFFFFF; padding: 12px 10px; border: none; font-weight: 700; }
QListWidget { background: #FFFFFF; border: 1px solid #E1ECE9; border-radius: 14px; padding: 8px; }
QListWidget::item { padding: 14px; border-bottom: 1px solid #EEF3F2; border-radius: 10px; }
QListWidget::item:selected { background: #D9F3EA; color: #1B2735; }
QProgressBar { background: rgba(255,255,255,0.25); border: none; border-radius: 6px; }
QProgressBar::chunk { background: #F7A823; border-radius: 6px; }
QFrame[card=&quot;white&quot;] QProgressBar { background: #E1ECE9; }
QFrame[card=&quot;white&quot;] QProgressBar::chunk { background: #12A87B; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #BFD6D1; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
</string>
